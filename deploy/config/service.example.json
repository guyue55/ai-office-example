{
  "database_user": "office_app",
  "database_password_file": "secrets/app_password",
  "database_host": "postgres",
  "database_port": 5432,
  "database_name": "office",
  "issuer": "https://identity.company.example/realms/office",
  "audience": "https://office.company.example/mcp",
  "public_url": "https://office.company.example",
  "web_session_secret_file": "secrets/web_session_secret",
  "web_authentication_max_age": 36000,
  "database_runtime": {
    "pool_size": 5,
    "max_overflow": 5,
    "pool_timeout": 3,
