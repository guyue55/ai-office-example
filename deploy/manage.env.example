# 管理脚本公开配置；不包含密码、令牌或证书内容。
# 相对路径均以项目根目录为基准；也可填写部署现场需要的绝对路径。

# 启动、重启、重建和升级的默认等待秒数；命令行--timeout可覆盖。
OFFICE_MANAGE_TIMEOUT=120

# 实例、锁、活动指针和默认备份所在的运行目录。
OFFICE_MANAGE_RUNTIME_DIR=runtime

# 以下路径若为相对值，以OFFICE_MANAGE_RUNTIME_DIR为基准。
OFFICE_MANAGE_BACKUP_DIR=backups
OFFICE_MANAGE_ACTIVE_INSTANCE=.active-server-instance
OFFICE_MANAGE_LOCK_DIR=.manage.lock

# macOS通过应用名称启动Docker Desktop；不要填写项目或用户目录。
OFFICE_MANAGE_DOCKER_APP=Docker

# 可固定默认实例；通常留空，由运行中实例或活动实例文件自动发现。
OFFICE_MANAGE_INSTANCE_DIR=
