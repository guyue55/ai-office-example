# 公开环境参数，不包含密码；建议首次通过bash deploy/configure.sh生成。
OFFICE_AGENT=0
# 可指定已发布镜像；不填写则从本交付源码构建。Agent镜像须同时设置OFFICE_AGENT=1。
# OFFICE_IMAGE=ghcr.io/your-org/your-repo/data-service:1.1.0-agent
OFFICE_DEPLOYMENT_MODE=https
OFFICE_PUBLIC_URL=https://office.example
OFFICE_INSTANCE_DIR=runtime/instance
OFFICE_CERTIFICATE_FILE=/path/to/fullchain.pem
OFFICE_PRIVATE_KEY_FILE=/path/to/privkey.pem
# 以下为已有外部PG18可选组合；必须整组明确配置，不写明文密码。
# OFFICE_DATABASE_HOST=192.168.1.20
# OFFICE_DATABASE_PORT=5432
# OFFICE_DATABASE_NAME=office
# OFFICE_DATABASE_OWNER=office_owner
# OFFICE_DATABASE_OWNER_PASSWORD_FILE=/secure/owner_password
# OFFICE_DATABASE_USER=office_app
# OFFICE_DATABASE_PASSWORD_FILE=/secure/app_password
# OFFICE_IDENTITY_DATABASE_NAME=office_identity
# OFFICE_IDENTITY_DATABASE_USER=office_identity
# OFFICE_IDENTITY_DATABASE_PASSWORD_FILE=/secure/identity_password
